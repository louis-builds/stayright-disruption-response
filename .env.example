# Copy to .env and adjust if needed. Same Postgres server as docker-compose.yml
# (host/port/user/password match the travel_disruption container) — the Kakapo
# prototype gets its own database on that server so its tables (properties/
# bookings) never collide with the C# backend's tables of the same name.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kakapo
PGUSER=app
PGPASSWORD=app_password
