# Copy to .env and adjust if needed. Same Postgres server/database as the C#
# backend (docker-compose.yml's travel_disruption container) — identify
# queries the real hotels/bookings tables directly so guest_id/booking_id
# are real ids the rest of the system already understands.
PGHOST=localhost
PGPORT=5432
PGDATABASE=travel_disruption
PGUSER=app
PGPASSWORD=app_password

# Optional. Only needed to poll LIVE flight data
# (detect/scripts/run_detect.py --source flight). Weather, volcano and road
# need no key at all.
#
# Get your OWN key -- each person subscribes their own, do NOT share one:
# the AeroDataBox free tier's call quota is per RapidAPI account, so a
# shared key runs out fast and then breaks for everyone.
#   1. sign up at rapidapi.com
#   2. open the "AeroDataBox" API, Subscribe -> Basic (free) plan
#   3. copy your X-RapidAPI-Key and paste it below
# Leave blank to skip the flight source, or use --simulate for a canned sample.
RAPIDAPI_KEY=

# Optional. S3 bucket for archiving uploaded hotel policy files.
# Leave blank to skip S3 archiving (local dev without AWS).
S3_POLICY_BUCKET=
